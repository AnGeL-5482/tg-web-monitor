# 1. Берем официальный минимальный образ Python на базе дистрибутива Debian Linux
FROM python:3.11-slim

# 2. Создаем рабочую папку внутри изолированной системы контейнера
WORKDIR /app

# 3. Копируем список наших внешних библиотек внутрь контейнера
COPY requirements.txt .

# 4. Запускаем установку зависимостей (aiogram, httpx, asyncio) внутри контейнера
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копируем сам наш скрипт мониторинга и остальные файлы в контейнер
COPY . .

# 6. Главная команда: запускаем наш интерактивный скрипт при старте
CMD ["python", "monitor.py"]
